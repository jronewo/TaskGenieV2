# Base URL of the TaskGenie API (includes the /api prefix).
VITE_API_BASE_URL=http://localhost:5258/api

# Google OAuth Web Client ID. Must match the backend's GoogleAuth:ClientId
# (src/TaskGenie.API/appsettings.json) so the ID token audience validates.
# Required for the Google sign-in button to appear — there is no built-in fallback.
VITE_GOOGLE_CLIENT_ID=546829754931-6r0b88k05n54o0e9vc25dokke7i3eu7g.apps.googleusercontent.com