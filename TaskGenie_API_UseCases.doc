  <tr><td>CreateTaskCommand</td><td>CreateTaskCommandHandler</td><td>Tạo task → Publish TaskCreatedEvent → ActivityLog ghi TASK_CREATED</td></tr>
  <tr><td>UpdateTaskCommand</td><td>UpdateTaskCommandHandler</td><td>Cập nhật task → Publish TaskUpdatedEvent; nếu Done → Publish TaskCompletedEvent</td></tr>
  <tr><td>DeleteTaskCommand</td><td>DeleteTaskCommandHandler</td><td>Xóa task</td></tr>
  <tr><td>UpdateTaskProgressCommand</td><td>UpdateTaskProgressCommandHandler</td><td>Cập nhật progress%, status, riskLevel</td></tr>
  <tr><td>SuggestEstimatedTimeCommand</td><td>SuggestEstimatedTimeCommandHandler</td><td>Tính toán thời gian ước tính dựa trên difficulty, priority, lịch sử</td></tr>
  <tr><td>AddTaskDependencyCommand</td><td>AddTaskDependencyCommandHandler</td><td>Kiểm tra circular dependency → thêm dependency</td></tr>
  <tr><td>RemoveTaskDependencyCommand</td><td>RemoveTaskDependencyCommandHandler</td><td>Xóa dependency</td></tr>
  <tr><td>GetDependencyGraphQuery</td><td>GetDependencyGraphQueryHandler</td><td>Lấy nodes + edges của đồ thị phụ thuộc</td></tr>
</table>

